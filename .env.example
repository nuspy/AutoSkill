# Local development defaults (backend reads this file from backend/.env or the environment).
AUTOSKILL_SECRET_KEY=dev-secret-change-me
AUTOSKILL_DATABASE_URL=sqlite+aiosqlite:///./autoskill.db
AUTOSKILL_JOBS=inline
AUTOSKILL_EVENTS=memory
AUTOSKILL_PUBLIC_URL=http://localhost:5173
AUTOSKILL_CORS_ORIGINS=["http://localhost:5173"]

# The browser extension this server pairs with, so the page can install skills without a terminal.
# The setup script served at /dl/installer/<platform> registers a native messaging host that accepts
# this id and no other, so the two halves have to name the same extension. Chrome shows the id on
# chrome://extensions with Developer mode on. Left empty, the download is refused rather than handing
# over a script that would register a host nothing is allowed to call.
# AUTOSKILL_EXTENSION_ID=

# llmswitch: the LLM providers of this machine, configured from Admin -> Providers.
# The registry file holds API keys and lives outside the repository; leave the path empty for the
# library default (%LOCALAPPDATA%/autoskill or ~/.config/autoskill/llm_providers.json).
AUTOSKILL_LLMSWITCH_ENABLED=1
# AUTOSKILL_LLMSWITCH_REGISTRY=/var/lib/autoskill/llm_providers.json
# 0 = a local engine is used only for what it already has in memory, never load on our own
AUTOSKILL_LLMSWITCH_LOAD_MODELS=1
