[Unit]
Description=AutoSkill background worker (arq)
After=network.target redis-server.service autoskill-api.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@TARGET@/app
EnvironmentFile=@TARGET@/autoskill.env
ExecStart=@TARGET@/venv/bin/arq autoskill.worker.WorkerSettings
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@TARGET@/data

[Install]
WantedBy=multi-user.target
